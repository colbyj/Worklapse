<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Worklapse.App.Views"
             x:Class="Worklapse.App.Views.PlaceholderView">
  <!-- A view still to be built: tool bar, recording messages and status bar like the others. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolBar" MinHeight="33">
      <TextBlock x:Name="TitleText" Classes="strong" VerticalAlignment="Center" Margin="6,0" />
    </Border>
    <views:RecordingMessages DockPanel.Dock="Top" x:Name="Messages" DataContext="{x:Null}" />
    <Border DockPanel.Dock="Bottom" Classes="statusBar">
      <StackPanel Orientation="Horizontal" Margin="8,0" Height="22">
        <views:RecordingIndicator x:Name="Indicator" DataContext="{x:Null}" />
      </StackPanel>
    </Border>
    <Border Background="{DynamicResource UiViewBrush}">
      <TextBlock x:Name="BodyText" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </DockPanel>
</UserControl>
