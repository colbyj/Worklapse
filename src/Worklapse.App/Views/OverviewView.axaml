<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Worklapse.App.ViewModels"
             xmlns:views="using:Worklapse.App.Views"
             xmlns:controls="using:Worklapse.App.Controls"
             xmlns:theming="using:Worklapse.App.Theming"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Worklapse.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="OverviewCellTemplate" x:DataType="vm:OverviewCell">
      <TextBlock Text="{Binding Text}" Classes="time" Classes.zero="{Binding IsZero}" />
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ic|SymbolIcon">
      <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Days you click to open in Day review: flat, tinted under the pointer like list items. -->
    <Style Selector="Button.day">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.day /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    </Style>
    <Style Selector="Button.day:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.day:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiAccentTintBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    </Style>

    <!-- Expand / collapse. -->
    <Style Selector="Button.chevron">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chevron ic|SymbolIcon">
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Border.groupRow">
      <Setter Property="Background" Value="{DynamicResource UiWindowBrush}" />
    </Style>
    <Style Selector="Border.groupRow TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.zero">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
    </Style>

    <Style Selector="Border.monthCell">
      <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style Selector="Border.monthCell.out">
      <Setter Property="Background" Value="{DynamicResource UiWindowBrush}" />
    </Style>
    <Style Selector="Border.monthCell.out TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
    </Style>
    <Style Selector="TextBlock.suggestions">
      <Setter Property="Foreground" Value="{DynamicResource UiAccentBrush}" />
    </Style>
    <Style Selector="Border.dayNumber">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.dayNumber.today">
      <Setter Property="Background" Value="{DynamicResource UiAccentBrush}" />
    </Style>
    <Style Selector="Border.dayNumber.today TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource UiOnAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolBar">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous" AutomationProperties.Name="Previous">
          <ic:SymbolIcon Symbol="ChevronLeft" />
        </Button>
        <TextBlock Text="{Binding RangeText}" Classes="strong" VerticalAlignment="Center" MinWidth="150" TextAlignment="Center" />
        <Button Classes="tool" Command="{Binding NextCommand}" ToolTip.Tip="Next" AutomationProperties.Name="Next">
          <ic:SymbolIcon Symbol="ChevronRight" />
        </Button>
        <Button Classes="tool" Content="{Binding TodayText}" Command="{Binding GoToTodayCommand}" />
        <Border Classes="separator" />
        <RadioButton Classes="tool" GroupName="overviewRange" Content="Week" IsChecked="{Binding IsWeek}" />
        <RadioButton Classes="tool" GroupName="overviewRange" Content="Month" IsChecked="{Binding IsMonth}" />
      </StackPanel>
    </Border>

    <views:RecordingMessages DockPanel.Dock="Top" x:Name="Messages" DataContext="{x:Null}" />

    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="10,5" IsVisible="{Binding HasError}"
            Background="{x:Static theming:AppBrushes.ErrorBar}" BorderBrush="{x:Static theming:AppBrushes.ErrorBarFrame}">
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="statusBar">
      <DockPanel Margin="8,0" Height="22">
        <TextBlock DockPanel.Dock="Right" Text="Click a day to review it" Classes="secondary" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <views:RecordingIndicator x:Name="Indicator" DataContext="{x:Null}" />
          <TextBlock Text="{Binding Title}" Classes="strong" VerticalAlignment="Center" />
          <TextBlock Text="{Binding AssignedTotalText, StringFormat='{}{0} assigned'}" Classes="secondary" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LoggedTotalText, StringFormat='{}{0} logged'}" Classes="secondary" VerticalAlignment="Center" />
          <TextBlock Text="{Binding NoProjectTotalText, StringFormat='{}{0} active without a project'}" Classes="secondary" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Week: a timeline per day. Month: a calendar of days. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource UiViewBrush}" BorderBrush="{DynamicResource UiSeparatorBrush}" BorderThickness="0,0,0,1">
      <Panel>
        <StackPanel IsVisible="{Binding IsWeek}">
          <Grid ColumnDefinitions="134,*,170" Height="22">
            <controls:HourScale Grid.Column="1" AxisStart="{Binding AxisStart}" AxisEnd="{Binding AxisEnd}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Assigned · recorded" Classes="secondary" VerticalAlignment="Center" Margin="14,0,0,0" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OverviewDayRow">
                <Button Classes="day" Command="{Binding Open}" Height="44" BorderBrush="{DynamicResource UiSeparatorBrush}"
                        ToolTip.Tip="Open in Day review" AutomationProperties.Name="{Binding DayText, StringFormat='Open {0} in Day review'}">
                  <Border BorderBrush="{DynamicResource UiSeparatorBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="134,*,170">
                      <StackPanel VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="{Binding DayText}" Classes="strong" />
                        <TextBlock Text="{Binding SpanText}" Classes="secondary" FontSize="11" IsVisible="{Binding !HasSuggestions}" />
                        <TextBlock Text="{Binding SuggestionsText}" Classes="suggestions" FontSize="11" IsVisible="{Binding HasSuggestions}"
                                   ToolTip.Tip="Suggested projects to decide in Day review" />
                      </StackPanel>
                      <controls:DayStrip Grid.Column="1" VerticalAlignment="Center"
                                         AxisStart="{Binding AxisStart}" AxisEnd="{Binding AxisEnd}"
                                         Blocks="{Binding Blocks}" Activity="{Binding Activity}" Now="{Binding Now}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="{Binding ActiveText}" Classes="strong" MinWidth="36" FontFeatures="+tnum" ToolTip.Tip="Active" />
                        <TextBlock Text="{Binding AssignedText}" Classes="secondary" FontFeatures="+tnum" ToolTip.Tip="Assigned to projects" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsMonth}">
          <ItemsControl ItemsSource="{x:Static vm:OverviewViewModel.WeekdayNames}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border BorderBrush="{DynamicResource UiSeparatorBrush}" BorderThickness="0,0,1,1" Padding="7,3">
                  <TextBlock Text="{Binding}" Classes="secondary" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding MonthCells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OverviewMonthCell">
                <Button Classes="day" Command="{Binding Open}" Height="56" IsHitTestVisible="{Binding InMonth}" Focusable="{Binding InMonth}"
                        AutomationProperties.Name="{Binding Day, StringFormat='Open {0:D} in Day review'}">
                  <Border Classes="monthCell" Classes.out="{Binding !InMonth}">
                    <DockPanel>
                      <controls:ShareBar DockPanel.Dock="Bottom" Segments="{Binding Bar}" Margin="0,0,0,2" />
                      <DockPanel VerticalAlignment="Top">
                        <Border DockPanel.Dock="Left" Classes="dayNumber" Classes.today="{Binding IsToday}">
                          <TextBlock Text="{Binding NumberText}" Classes="strong" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border DockPanel.Dock="Left" Classes="countBadge" IsVisible="{Binding HasSuggestions}" VerticalAlignment="Center"
                                Margin="4,0,0,0" ToolTip.Tip="{Binding SuggestionsTip}">
                          <TextBlock Text="{Binding Suggestions}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ActiveText}" Classes="strong" FontFeatures="+tnum" ToolTip.Tip="Active" />
                          <TextBlock Text="{Binding AssignedText}" Classes="secondary" FontSize="11" FontFeatures="+tnum" ToolTip.Tip="Assigned to projects"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </DockPanel>
                    </DockPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Panel>
    </Border>

    <Grid ColumnDefinitions="*,360" ColumnSpacing="10" Margin="10">
      <!-- Totals by category and project, a column per day or week. -->
      <Border BorderBrush="{DynamicResource UiFrameBrush}" BorderThickness="1" Background="{DynamicResource UiViewBrush}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Classes="gridHeader" ColumnDefinitions="200,*,70,70" Margin="0,0,14,0">
            <TextBlock Text="Category / project" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="2" Text="Assigned" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Logged" HorizontalAlignment="Right" />
          </Grid>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource UiFrameBrush}" BorderThickness="0,1,0,0">
            <StackPanel Margin="0,0,14,0">
              <Grid ColumnDefinitions="200,*,70,70" Height="23">
                <TextBlock Text="Assigned" Classes="strong" Margin="6,0" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding AssignedFooter}" ItemTemplate="{StaticResource OverviewCellTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Grid.Column="2" Text="{Binding AssignedTotalText}" Classes="strong time" />
                <TextBlock Grid.Column="3" Text="{Binding LoggedTotalText}" Classes="strong time" />
              </Grid>
              <Grid ColumnDefinitions="200,*,70,70" Height="23">
                <TextBlock Text="Recorded" Classes="secondary" Margin="6,0" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding RecordedFooter}" ItemTemplate="{StaticResource OverviewCellTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Grid.Column="2" Text="{Binding RecordedTotalText}" Classes="secondary time" />
              </Grid>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Visible">
            <ItemsControl ItemsSource="{Binding Tree}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OverviewTreeRow">
                  <Border Classes="row" Classes.groupRow="{Binding IsGroup}">
                    <Grid ColumnDefinitions="200,*,70,70">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}">
                        <Button Classes="tool chevron" Command="{Binding Toggle}" IsVisible="{Binding IsGroup}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Expand or collapse {0}'}">
                          <Panel>
                            <ic:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding IsExpanded}" />
                            <ic:SymbolIcon Symbol="ChevronRight" IsVisible="{Binding !IsExpanded}" />
                          </Panel>
                        </Button>
                        <Panel Width="10" Height="10" VerticalAlignment="Center">
                          <Rectangle RadiusX="2" RadiusY="2" Fill="{Binding Brush}" IsVisible="{Binding HasBrush}" />
                          <Rectangle RadiusX="2" RadiusY="2" Stroke="{DynamicResource UiFrameBrush}" IsVisible="{Binding !HasBrush}" />
                        </Panel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                      </StackPanel>
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource OverviewCellTemplate}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <TextBlock Grid.Column="2" Text="{Binding AssignedText}" Classes="time" />
                      <TextBlock Grid.Column="3" Text="{Binding LoggedText}" Classes="time" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- The days' notes; each opens to its projects' notes. -->
      <Border Grid.Column="1" BorderBrush="{DynamicResource UiFrameBrush}" BorderThickness="1" Background="{DynamicResource UiViewBrush}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Classes="gridHeader" ColumnDefinitions="*,Auto">
            <TextBlock Text="Notes" />
            <TextBlock Grid.Column="1" Text="Expand a day for its projects' notes" />
          </Grid>
          <Panel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OverviewNoteRow">
                    <Border Classes="row" Padding="4,4">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="22,50,*">
                          <Button Classes="tool chevron" Command="{Binding ToggleCommand}" IsVisible="{Binding HasEntries}" VerticalAlignment="Top"
                                  AutomationProperties.Name="{Binding DayText, StringFormat='Project notes of {0}'}">
                            <Panel>
                              <ic:SymbolIcon Symbol="ChevronDown" IsVisible="{Binding IsExpanded}" />
                              <ic:SymbolIcon Symbol="ChevronRight" IsVisible="{Binding !IsExpanded}" />
                            </Panel>
                          </Button>
                          <TextBlock Grid.Column="1" Text="{Binding DayText}" Classes="strong" VerticalAlignment="Top" Margin="0,1,0,0" />
                          <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontStyle="{Binding TextStyle}"
                                     Classes.secondary="{Binding !HasDayNote}" Margin="0,1,0,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Entries}" IsVisible="{Binding ShowsEntries}" Margin="72,0,0,2">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OverviewNoteEntry">
                              <Grid ColumnDefinitions="14,*" Margin="0,1">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="11">
                                  <Run Text="{Binding Project}" FontWeight="SemiBold" />
                                  <Run Text="{Binding Text}" />
                                </TextBlock>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No notes" Classes="secondary" IsVisible="{Binding HasNoNotes}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>

</UserControl>
