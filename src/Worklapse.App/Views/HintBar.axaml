<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Worklapse.App.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Worklapse.App.Views.HintBar"
             x:DataType="vm:Hint">
  <!-- Under a view's tool bar, with the recording messages: what the view is for, until it's closed. -->
  <Border IsVisible="{Binding IsShown}" BorderThickness="0,0,0,1" Padding="10,5"
          Background="{DynamicResource UiAccentTintBrush}" BorderBrush="{DynamicResource UiSeparatorBrush}">
    <DockPanel>
      <Button DockPanel.Dock="Right" Classes="tool" Command="{Binding DismissCommand}" VerticalAlignment="Top"
              ToolTip.Tip="Close this tip" AutomationProperties.Name="Close this tip">
        <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
      </Button>
      <ic:SymbolIcon DockPanel.Dock="Left" Symbol="Lightbulb" FontSize="16" Foreground="{DynamicResource UiAccentBrush}"
                     VerticalAlignment="Top" Margin="0,1,8,0" />
      <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
        <Run Text="{Binding Heading}" FontWeight="SemiBold" />
        <Run Text="{Binding Text}" />
      </TextBlock>
    </DockPanel>
  </Border>
</UserControl>
