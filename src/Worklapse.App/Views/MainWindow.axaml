<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Worklapse.App.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Worklapse.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="avares://Worklapse/Assets/worklapse.ico"
        Width="1400" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource UiChromeBrush}"
        TransparencyBackgroundFallback="{DynamicResource UiWindowBrush}">
  <Window.Styles>
    <!-- The rail: icon buttons that switch views (top) and reach recording and Settings (bottom). The shown view's
         button has the selection fill and an accent mark on its left, like Windows' navigation panes. -->
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.rail /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiAccentTintBrush}" />
    </Style>
    <Style Selector="Button.rail.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiSeparatorBrush}" />
    </Style>
    <Style Selector="Button.rail ic|SymbolIcon">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail Border.mark">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="1.5" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource UiAccentBrush}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.rail.selected Border.mark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </Window.Styles>

  <!-- Ctrl+W and Ctrl+Q are added in code (they act on the window, not the view model). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ShowOverviewCommand}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding ShowDayReviewCommand}" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding ShowTimesheetCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- The rail. -->
    <Border DockPanel.Dock="Left" Width="48" Background="{DynamicResource UiChromeBrush}"
            BorderBrush="{DynamicResource UiSeparatorBrush}" BorderThickness="0,0,1,0" Padding="0,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
          <Button Classes="rail" Command="{Binding Recording.TogglePauseCommand}" ToolTip.Tip="{Binding Recording.RailTip}"
                  AutomationProperties.Name="{Binding Recording.RailTip}">
            <Panel Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse Stroke="{DynamicResource UiTextBrush}" StrokeThickness="1.3" />
              <Ellipse Width="8" Height="8" Fill="{Binding Recording.DotBrush}" IsVisible="{Binding Recording.ShowsDot}" />
              <Path IsVisible="{Binding Recording.IsPaused}" Width="7" Height="8" Stretch="Fill"
                    Fill="{DynamicResource UiTextBrush}" Data="M0,0 H2.5 V8 H0 Z M4.5,0 H7 V8 H4.5 Z" />
            </Panel>
          </Button>
          <Button Classes="rail" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
            <ic:SymbolIcon Symbol="Settings" />
          </Button>
        </StackPanel>
        <StackPanel Spacing="2">
          <Button Classes="rail" Classes.selected="{Binding IsOverview}" Command="{Binding ShowOverviewCommand}"
                  ToolTip.Tip="Overview (Ctrl+1)" AutomationProperties.Name="Overview">
            <Panel>
              <Border Classes="mark" />
              <ic:SymbolIcon Symbol="GanttChart" />
            </Panel>
          </Button>
          <Button Classes="rail" Classes.selected="{Binding IsDayReview}" Command="{Binding ShowDayReviewCommand}"
                  ToolTip.Tip="Day review (Ctrl+2)" AutomationProperties.Name="Day review">
            <Panel>
              <Border Classes="mark" />
              <ic:SymbolIcon Symbol="VideoClip" />
            </Panel>
          </Button>
          <Button Classes="rail" Classes.selected="{Binding IsTimesheet}" Command="{Binding ShowTimesheetCommand}"
                  ToolTip.Tip="Timesheet (Ctrl+3)" AutomationProperties.Name="Timesheet">
            <Panel>
              <Border Classes="mark" />
              <ic:SymbolIcon Symbol="DocumentTable" />
            </Panel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- A downloaded update, over every view. -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding Updates.IsReady}" Padding="10,5" BorderThickness="0,0,0,1"
            Background="{DynamicResource UiAccentTintBrush}" BorderBrush="{DynamicResource UiSeparatorBrush}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Restart to Update" Command="{Binding Updates.RestartCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ic:SymbolIcon Symbol="ArrowCircleDown" FontSize="16" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Updates.ReadyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="It installs when Worklapse quits." VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The views; only the current one is visible. -->
    <Panel x:Name="Host" />
  </DockPanel>
</Window>
