<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Worklapse.App.Views.SettingsErrorWindow"
        Title="Worklapse"
        Icon="avares://Worklapse/Assets/worklapse.ico"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="buttonBar">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Start with Default Settings" Click="OnStartWithDefaults" />
        <Button Content="Quit" Classes="accent" IsDefault="True" IsCancel="True" Click="OnQuit" />
      </StackPanel>
    </Border>

    <StackPanel Margin="16,14" Spacing="8">
      <TextBlock Text="Worklapse can't read its settings" FontSize="16" FontWeight="SemiBold" />
      <SelectableTextBlock x:Name="PathText" TextWrapping="Wrap" />
      <SelectableTextBlock x:Name="ErrorText" Classes="secondary" TextWrapping="Wrap" />
      <TextBlock TextWrapping="Wrap"
                 Text="Fix the file and start Worklapse again, or start with default settings. The file is then kept next to the new one with “.broken” and the date added to its name." />
      <TextBlock x:Name="DefaultsText" TextWrapping="Wrap" />
      <TextBlock x:Name="SetAsideError" Classes="warning" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
  </DockPanel>
</Window>
