<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Worklapse.App.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:controls="using:Worklapse.App.Controls"
        x:Class="Worklapse.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings — Worklapse"
        Icon="avares://Worklapse/Assets/worklapse.ico"
        Width="760" Height="800" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <!-- Column headers of the Applications list: flat with dividers between them, click to sort. -->
    <Style Selector="Button.columnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.columnHeader /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.columnHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource UiAccentTintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
    </Style>
    <!-- Dense rows: the check boxes overlap the row padding by 3 px above and below (see their Margin), so a row is
         as tall as its text. -->
    <Style Selector="ListBox.programs ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.programs CheckBox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="ListBox.programs ComboBox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
    <!-- Colour swatches to pick from: the selection shows as the item's highlight around the swatch. -->
    <Style Selector="ListBox.palette">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.palette ListBoxItem">
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="0,0,2,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- The chosen colour gets a ring in the text colour, plainer than the list's selection fill. -->
    <Style Selector="ListBox.palette ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource UiTextBrush}" />
    </Style>
    <Style Selector="ListBox.palette ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource UiSecondaryTextBrush}" />
    </Style>
    <Style Selector="ListBox.palette ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource UiTextBrush}" />
    </Style>
    <Style Selector="ListBox.projects ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <!-- A project's window title rules: a grid of cells to type in, a hairline between the rows. -->
    <Style Selector="ListBox.titleRules ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.titleRules ComboBox.cell">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.titleMatches ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="buttonBar" BorderThickness="0" Padding="10,8,10,9">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="Defaults" Click="OnDefaults" IsVisible="{Binding HasDefaults}"
                ToolTip.Tip="Put this page's settings back to their defaults" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="OK" Classes="accent" IsDefault="True" IsEnabled="{Binding CanConfirm}" Click="OnOk" />
          <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
          <Button Content="Apply" IsEnabled="{Binding CanApply}" Click="OnApply" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Margin="10,10,10,0" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Recording">
    <ScrollViewer>
      <StackPanel Margin="10" Spacing="8">

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="groupHeader" Text="Capture" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Classes="label" Text="Capture:" VerticalAlignment="Top" Margin="0,6,10,0" />
              <StackPanel Grid.Column="1">
                <RadioButton GroupName="mode" Content="Active application only" IsChecked="{Binding IsActiveApplication}" />
                <RadioButton GroupName="mode" Content="Primary monitor" IsChecked="{Binding IsPrimaryMonitor}"
                             IsVisible="{Binding ShowsPrimaryMonitor}" />
                <RadioButton GroupName="mode" Content="Selected monitors:" IsChecked="{Binding IsSelectedMonitors}" />
                <ItemsControl ItemsSource="{Binding Monitors}" Margin="26,0,0,4" IsEnabled="{Binding IsSelectedMonitors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonitorOption">
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <RadioButton GroupName="mode" Content="All monitors" IsChecked="{Binding IsAllMonitors}" />
              </StackPanel>

              <TextBlock Grid.Row="1" Classes="label" Text="Interval:" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <NumericUpDown Value="{Binding IntervalSeconds}" Minimum="2" Maximum="300" Increment="1" FormatString="0" Width="72" />
                <TextBlock Text="seconds" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="groupHeader" Text="Idle" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Classes="label" Text="Stop capturing after:" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <NumericUpDown Value="{Binding IdleMinutes}" Minimum="1" Maximum="120" Increment="1" FormatString="0" Width="72" />
                <TextBlock Text="minutes without keyboard or mouse input" VerticalAlignment="Center" />
              </StackPanel>
              <CheckBox Grid.Row="1" Grid.Column="1" Content="Stop capturing while the screen is locked" IsChecked="{Binding PauseWhenLocked}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint"
                         Text="When the idle limit is reached, the minutes since the last input are counted as idle too." />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="groupHeader" Text="Recording" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Classes="label" Text="Store captures as:" VerticalAlignment="Top" Margin="0,6,10,0" />
              <!-- What each choice costs, from the measurements in docs/PROJECT.md (Benchmarks). -->
              <StackPanel Grid.Column="1" Spacing="4">
                <RadioButton GroupName="format" IsChecked="{Binding IsVideo}" AutomationProperties.Name="Video (AV1)">
                  <StackPanel>
                    <TextBlock Text="Video (AV1)" />
                    <TextBlock Classes="hint" Text="Smallest on disk, but small text can lag, and RAM spikes while encoding" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="format" IsChecked="{Binding IsJpeg}" AutomationProperties.Name="JPEG images">
                  <StackPanel>
                    <TextBlock Text="JPEG images" />
                    <TextBlock Classes="hint" Text="Least CPU, less RAM than AV1, but much more disk and blurrier text" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="format" IsChecked="{Binding IsWebP}" AutomationProperties.Name="WebP images">
                  <StackPanel>
                    <TextBlock Text="WebP images" />
                    <TextBlock Classes="hint" Text="Clearer text for the same disk space, uses less RAM than AV1, but as much CPU" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>

              <!-- One slider per format. Image quality runs the other way round from the video quantizer, so each
                   is sharper on the left. -->
              <TextBlock Grid.Row="1" Classes="label" Text="Compression:" IsVisible="{Binding IsVideo}" />
              <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsVideo}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding QualityText}" FontWeight="SemiBold" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Classes="hint" Text="Smaller" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock DockPanel.Dock="Left" Classes="hint" Text="Sharper" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Value="{Binding Quality}" Minimum="20" Maximum="55" TickFrequency="1" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="Video compression" />
              </DockPanel>
              <TextBlock Grid.Row="1" Classes="label" Text="Quality:" IsVisible="{Binding IsJpeg}" />
              <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsJpeg}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding JpegQualityText}" FontWeight="SemiBold" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Classes="hint" Text="Smaller" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock DockPanel.Dock="Left" Classes="hint" Text="Sharper" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Value="{Binding JpegQuality}" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                        IsDirectionReversed="True" AutomationProperties.Name="JPEG quality" />
              </DockPanel>
              <TextBlock Grid.Row="1" Classes="label" Text="Quality:" IsVisible="{Binding IsWebP}" />
              <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsWebP}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding WebPQualityText}" FontWeight="SemiBold" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Classes="hint" Text="Smaller" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock DockPanel.Dock="Left" Classes="hint" Text="Sharper" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Value="{Binding WebPQuality}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                        IsDirectionReversed="True" AutomationProperties.Name="WebP quality" />
              </DockPanel>

              <TextBlock Grid.Row="2" Grid.Column="1" Classes="warning" IsVisible="{Binding QualityWarning}"
                         Text="At this setting small text can come out garbled or out of date." />

              <!-- The most detailed part of the primary monitor, as it would be stored, at 1:1. -->
              <TextBlock Grid.Row="3" Classes="label" Text="Preview:" VerticalAlignment="Top" Margin="0,4,10,0" IsVisible="{Binding HasPreview}" />
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4" IsVisible="{Binding HasPreview}">
                <Border x:Name="PreviewBox" Height="220" ClipToBounds="True" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource UiFrameBrush}" Background="{DynamicResource UiViewBrush}">
                  <Panel>
                    <Image Source="{Binding Preview.Image}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Border IsVisible="{Binding Preview.IsBusy}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                            Padding="6,2" CornerRadius="3" Background="{DynamicResource UiHeaderBrush}">
                      <TextBlock Classes="hint" Text="Updating…" />
                    </Border>
                  </Panel>
                </Border>
                <TextBlock Classes="secondary" Text="{Binding Preview.SizeText}"
                           IsVisible="{Binding Preview.SizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <TextBlock Grid.Row="4" Grid.Column="1" Classes="hint" Text="Applies to captures recorded from now on." />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="groupHeader" Text="Storage" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Classes="label" Text="History folder:" />
              <DockPanel Grid.Column="1">
                <Button DockPanel.Dock="Right" Content="Default" Margin="6,0,0,0" Click="OnDefaultFolder"
                        ToolTip.Tip="Use the standard history folder" />
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowse" />
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Padding="8,5" Click="OnOpenFolder" IsEnabled="{Binding DataFolderExists}"
                        ToolTip.Tip="Open this folder" AutomationProperties.Name="Open the history folder">
                  <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                </Button>
                <TextBox Text="{Binding DataFolder}" />
              </DockPanel>
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="warning" IsVisible="{Binding !HasDataFolder}"
                         Text="Choose a history folder (Browse…), or Default for the standard one." />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint"
                         Text="Recordings and the activity log are kept here. Changing it doesn't move existing history." />

              <TextBlock Grid.Row="3" Classes="label" Text="TimeSnapper:" Margin="0,6,10,0" IsVisible="{Binding CanImportTimeSnapper}" />
              <Button Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" HorizontalAlignment="Left" Content="Import history…"
                      Click="OnImportTimeSnapper" IsVisible="{Binding CanImportTimeSnapper}" />
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
      </TabItem>

      <TabItem Header="General">
        <StackPanel Margin="10" Spacing="8">
          <Border Classes="group">
            <StackPanel>
              <TextBlock Classes="groupHeader" Text="Startup and notifications" />
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Classes="label" Text="Startup:" VerticalAlignment="Top" Margin="0,6,10,0" />
                <StackPanel Grid.Column="1">
                  <CheckBox Content="{Binding StartAtLoginText}" IsChecked="{Binding StartAtLogin}" IsVisible="{Binding CanStartAtLogin}" />
                  <CheckBox Content="Record when Worklapse starts" IsChecked="{Binding RecordAtStartup}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Classes="label" Text="Notifications:" VerticalAlignment="Top" Margin="0,6,10,0" />
                <StackPanel Grid.Row="1" Grid.Column="1">
                  <CheckBox Content="When recording starts" IsChecked="{Binding NotifyWhenRecordingStarts}" />
                  <CheckBox Content="When closing the window leaves Worklapse in the tray" IsChecked="{Binding NotifyWhenInTray}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="group">
            <StackPanel>
              <TextBlock Classes="groupHeader" Text="Days" />
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Classes="label" Text="Day starts at:" />
                <TextBox Grid.Column="1" Text="{Binding DayStartText}" Width="72" HorizontalAlignment="Left"
                         AutomationProperties.Name="Day starts at" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" IsVisible="{Binding DayStartIsValid}"
                           Text="Earlier hours count toward the day before" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="warning" IsVisible="{Binding !DayStartIsValid}"
                           Text="A 24-hour time, 00:00 to 23:59" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="group">
            <StackPanel>
              <TextBlock Classes="groupHeader" Text="Theme" />
              <!-- In the order of ThemeStyle and ThemeMode. -->
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Classes="label" Text="Style:" />
                <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeStyleIndex}" MinWidth="180" AutomationProperties.Name="Style">
                  <ComboBoxItem Content="Match the desktop" />
                  <ComboBoxItem Content="Windows" />
                  <ComboBoxItem Content="KDE" />
                  <ComboBoxItem Content="GTK" />
                </ComboBox>
                <TextBlock Grid.Row="1" Classes="label" Text="Colours:" />
                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding ThemeModeIndex}" MinWidth="180" AutomationProperties.Name="Colours">
                  <ComboBoxItem Content="Match the desktop" />
                  <ComboBoxItem Content="Light" />
                  <ComboBoxItem Content="Dark" />
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <TabItem Header="Applications">
        <DockPanel Margin="10" DataContext="{Binding Programs}" x:DataType="vm:ProgramsViewModel">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Classes="secondary" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox Text="{Binding Filter}" PlaceholderText="Filter by name" Width="240" HorizontalAlignment="Left" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="A project's window titles decide first, then a website, then its browser. Productive and Project apply to all history; Excluded stops recording while it has the focus." />
          <Border BorderBrush="{DynamicResource UiFrameBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource UiViewBrush}" ClipToBounds="True">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="{DynamicResource UiHeaderBrush}" BorderBrush="{DynamicResource UiSeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="88,76,92,62,*,64,140,84" Margin="0,0,14,0">
                  <Button Classes="columnHeader" HorizontalContentAlignment="Center" Content="{Binding ProductiveHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Productive}" />
                  <Button Grid.Column="1" Classes="columnHeader" HorizontalContentAlignment="Center" Content="{Binding ExcludedHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Excluded}" />
                  <Button Grid.Column="2" Classes="columnHeader" HorizontalContentAlignment="Center" Content="{Binding ReadScreenHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.ReadScreen}"
                          ToolTip.Tip="Read the text in its windows, for suggestions · off deletes what was read" />
                  <Button Grid.Column="3" Classes="columnHeader" HorizontalContentAlignment="Center" Content="{Binding LearnHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Learn}"
                          ToolTip.Tip="Its windows teach suggestions and count toward them" />
                  <Button Grid.Column="4" Classes="columnHeader" Content="{Binding NameHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Name}" />
                  <Button Grid.Column="5" Classes="columnHeader" Content="{Binding KindHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Kind}" />
                  <Button Grid.Column="6" Classes="columnHeader" Content="{Binding ProjectHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Project}" />
                  <Button Grid.Column="7" Classes="columnHeader" Content="{Binding RecordedHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Recorded}" HorizontalContentAlignment="Right" />
                </Grid>
              </Border>
              <ListBox Classes="programs" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProgramRow">
                    <Grid ColumnDefinitions="82,76,92,62,*,64,140,78">
                      <CheckBox IsChecked="{Binding Productive}" AutomationProperties.Name="{Binding Name, StringFormat='Productive: {0}'}"
                                HorizontalAlignment="Center" Margin="-6,-3,0,-3" Padding="0" />
                      <CheckBox Grid.Column="1" IsChecked="{Binding Excluded}" AutomationProperties.Name="{Binding Name, StringFormat='Excluded: {0}'}"
                                HorizontalAlignment="Center" Margin="0,-3,0,-3" Padding="0" />
                      <CheckBox Grid.Column="2" IsChecked="{Binding ReadScreen}" IsEnabled="{Binding !Excluded}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Read screen: {0}'}"
                                HorizontalAlignment="Center" Margin="0,-3,0,-3" Padding="0" />
                      <CheckBox Grid.Column="3" IsChecked="{Binding Learn}" IsEnabled="{Binding !Excluded}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Learn from: {0}'}"
                                HorizontalAlignment="Center" Margin="0,-3,0,-3" Padding="0" />
                      <TextBlock Grid.Column="4" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="5" Text="{Binding KindText}" Classes="secondary" VerticalAlignment="Center" Margin="8,0,0,0" />
                      <ComboBox Grid.Column="6" HorizontalAlignment="Stretch" Margin="2,-3,8,-3"
                                ItemsSource="{Binding $parent[ListBox].((vm:ProgramsViewModel)DataContext).ProjectChoices}"
                                SelectedItem="{Binding Project}" AutomationProperties.Name="{Binding Name, StringFormat='Project: {0}'}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProjectItem">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" IsVisible="{Binding !IsNone}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding DisplayName}" Classes.secondary="{Binding IsNone}" />
                            </StackPanel>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Grid.Column="7" Text="{Binding RecordedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Projects">
        <DockPanel Margin="10" DataContext="{Binding Projects}" x:DataType="vm:ProjectsViewModel">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Classes="secondary" VerticalAlignment="Center" Margin="12,0,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="New Project" Command="{Binding NewProjectCommand}" />
              <Button Content="New Category" Command="{Binding NewCategoryCommand}" />
              <Button Content="Delete" Click="OnDeleteProject" IsEnabled="{Binding CanDeleteSelected}" />
              <CheckBox Content="Show archived" IsChecked="{Binding ShowArchived}" Margin="10,0,0,0" />
            </StackPanel>
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="warning" Margin="0,8,0,0" IsVisible="{Binding !IsValid}"
                     Text="Every project and category needs a name." />
          <Grid ColumnDefinitions="230,*" ColumnSpacing="12">
            <Border BorderBrush="{DynamicResource UiFrameBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource UiViewBrush}" ClipToBounds="True">
              <ListBox Classes="projects" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                       AutomationProperties.Name="Categories and projects">
                <ListBox.DataTemplates>
                  <DataTemplate DataType="vm:CategoryItem">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                  <DataTemplate DataType="vm:ProjectItem">
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="17,0,0,0">
                      <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Classes.secondary="{Binding Archived}" />
                    </StackPanel>
                  </DataTemplate>
                  <DataTemplate DataType="vm:NoCategoryHeading">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Classes="secondary" Margin="17,0,0,0" />
                  </DataTemplate>
                </ListBox.DataTemplates>
              </ListBox>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding Selected}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:CategoryItem">
                  <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <TextBlock Classes="label" Text="Name:" />
                    <TextBox Grid.Column="1" Text="{Binding Name}" AutomationProperties.Name="Category name" />
                    <TextBlock Grid.Row="1" Classes="label" Text="Colour:" VerticalAlignment="Top" Margin="0,4,10,0" />
                    <ListBox Grid.Row="1" Grid.Column="1" Classes="palette" ItemsSource="{Binding Palette}" SelectedItem="{Binding SelectedPaletteColor}"
                             AutomationProperties.Name="Category colour">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteColor">
                          <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Brush}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint" Text="Its projects use this colour unless they have their own" />
                  </Grid>
                </DataTemplate>

                <DataTemplate DataType="vm:ProjectItem">
                  <!-- The titles matched take the height left, down to a few rows; below that the form scrolls. -->
                  <ScrollViewer>
                  <controls:ViewportGrid ColumnDefinitions="90,*" RowSpacing="10">
                    <controls:ViewportGrid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" MinHeight="72" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </controls:ViewportGrid.RowDefinitions>
                    <TextBlock Classes="label" Text="Name:" />
                    <TextBox Grid.Column="1" Text="{Binding Name}" AutomationProperties.Name="Project name" />

                    <TextBlock Grid.Row="1" Classes="label" Text="Category:" />
                    <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="200" ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding Category}"
                              AutomationProperties.Name="Category">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryItem">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" IsVisible="{Binding !IsNone}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" Classes.secondary="{Binding IsNone}" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Classes="label" Text="Colour:" VerticalAlignment="Top" Margin="0,4,10,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                      <RadioButton GroupName="projectColor" IsChecked="{Binding UsesCategoryColor}" AutomationProperties.Name="The category's colour">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="The category’s" />
                          <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding CategoryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </RadioButton>
                      <RadioButton GroupName="projectColor" Content="Its own" IsChecked="{Binding UsesOwnColor}" />
                      <ListBox Classes="palette" Margin="22,0,0,0" ItemsSource="{Binding Palette}" SelectedItem="{Binding SelectedPaletteColor}"
                               IsEnabled="{Binding UsesOwnColor}" AutomationProperties.Name="Project colour">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:PaletteColor">
                            <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Brush}" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Classes="label" Text="Linked:" VerticalAlignment="Top" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding LinkedText}" TextWrapping="Wrap" />
                      <TextBlock Classes="hint" Text="Link apps and sites on the Applications tab" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Classes="label" Text="Window titles:" VerticalAlignment="Top" Margin="0,4,10,0" />
                    <DockPanel Grid.Row="4" Grid.Column="1">
                      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource UiFrameBrush}" BorderThickness="1" CornerRadius="4"
                              Background="{DynamicResource UiViewBrush}" ClipToBounds="True">
                        <DockPanel>
                          <Grid DockPanel.Dock="Top" Classes="gridHeader" ColumnDefinitions="*,160,84">
                            <TextBlock Text="Title contains" />
                            <TextBlock Grid.Column="1" Text="Only in" />
                            <TextBlock Grid.Column="2" Text="Matched" HorizontalAlignment="Right" />
                          </Grid>
                          <ListBox Classes="titleRules" ItemsSource="{Binding TitleRules}" SelectedItem="{Binding SelectedRule}"
                                   Background="Transparent" BorderThickness="0" MinHeight="50" MaxHeight="128" GotFocus="OnTitleRuleGotFocus"
                                   AutomationProperties.Name="Window title rules">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:TitleRuleItem">
                                <Grid ColumnDefinitions="*,160,84">
                                  <TextBox Classes="cell" Margin="1" Text="{Binding Text}" PlaceholderText="Text in the title"
                                           AutomationProperties.Name="Title contains" />
                                  <ComboBox Grid.Column="1" Classes="cell" Margin="1" ItemsSource="{Binding AppChoices}" SelectedItem="{Binding App}"
                                            AutomationProperties.Name="Only in">
                                    <ComboBox.ItemTemplate>
                                      <DataTemplate x:DataType="vm:AppChoice">
                                        <TextBlock Text="{Binding DisplayName}" Classes.secondary="{Binding IsAny}" TextTrimming="CharacterEllipsis" />
                                      </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <TextBlock Grid.Column="2" Classes="time" Text="{Binding MatchedText}" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </DockPanel>
                      </Border>

                      <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Left" Content="Add" Click="OnAddTitleRule" />
                        <Button DockPanel.Dock="Left" Content="Remove" Click="OnRemoveTitleRule" IsEnabled="{Binding HasSelectedRule}" Margin="6,0,0,0" />
                        <TextBlock Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="Ignores case · beats site and app links · applies to all history" />
                      </DockPanel>

                      <TextBlock DockPanel.Dock="Top" Classes="secondary" Text="{Binding MatchesHeading}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- The one row that shrinks, so the rows that can't are all measured in full. 3 below its heading, not 10. -->
                    <Border Grid.Row="5" Grid.Column="1" Margin="0,-7,0,0" BorderBrush="{DynamicResource UiFrameBrush}" BorderThickness="1" CornerRadius="4"
                            Background="{DynamicResource UiViewBrush}" ClipToBounds="True">
                      <Panel>
                        <ListBox Classes="titleMatches" ItemsSource="{Binding Matches}" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="Titles matched">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TitleMatchRow">
                              <Grid ColumnDefinitions="120,*,Auto,64" ColumnSpacing="8">
                                <TextBlock Text="{Binding App}" Classes="secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding Title}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTaken}" VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding TakenByName, StringFormat='A rule of {0} decides for this title'}">
                                  <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding TakenByBrush}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding TakenByName}" Classes="secondary" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Classes="time" Margin="0" Text="{Binding TimeText}" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="secondary" Margin="8,6" Text="{Binding NoMatchesText}" IsVisible="{Binding HasNoMatches}" />
                      </Panel>
                    </Border>

                    <TextBlock Grid.Row="6" Classes="label" Text="Suggestions:" VerticalAlignment="Top" Margin="0,6,10,0" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Spacing="2">
                      <CheckBox Content="Suggest it" IsChecked="{Binding Suggest}" />
                      <TextBlock Classes="hint" Text="Off: never suggested, and its time teaches nothing" Margin="26,0,0,2" />
                      <StackPanel Orientation="Horizontal" Spacing="4" Margin="26,0,0,4" IsEnabled="{Binding Suggest}">
                        <CalendarDatePicker SelectedDate="{Binding StartsOn}" PlaceholderText="First day" Width="130"
                                            AutomationProperties.Name="Suggested from" ToolTip.Tip="Its first day; blank: no limit" />
                        <TextBlock Text="to" VerticalAlignment="Center" />
                        <CalendarDatePicker SelectedDate="{Binding EndsOn}" PlaceholderText="Last day" Width="130"
                                            AutomationProperties.Name="Suggested to" ToolTip.Tip="Its last day; blank: no limit" />
                      </StackPanel>
                      <CheckBox Content="Read the screen during its time" IsChecked="{Binding ReadScreen}" />
                      <TextBlock Classes="hint" Text="Off: its time isn't read, and what was read is deleted" Margin="26,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="7" Grid.Column="1" Spacing="2">
                      <CheckBox Content="Archived" IsChecked="{Binding Archived}" />
                      <TextBlock Classes="hint" Text="Hidden from lists, history kept" />
                    </StackPanel>
                  </controls:ViewportGrid>
                  </ScrollViewer>
                </DataTemplate>

                <DataTemplate DataType="vm:NoCategoryHeading">
                  <TextBlock Classes="hint" Text="Projects without a category. Pick one for a project to move it." TextWrapping="Wrap" />
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Suggestions">
        <StackPanel Margin="10" Spacing="8">
          <Border Classes="group">
            <StackPanel>
              <TextBlock Classes="groupHeader" Text="Suggestions" />
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <CheckBox Grid.Column="1" Content="Suggest projects for time without one" IsChecked="{Binding SuggestProjects}" />
                <TextBlock Grid.Row="1" Classes="label" Text="Offer when:" VerticalAlignment="Top" Margin="0,6,10,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" IsEnabled="{Binding SuggestProjects}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <NumericUpDown Value="{Binding MinimumCertainty}" Minimum="0" Maximum="99" Increment="5" FormatString="0" Width="72"
                                   AutomationProperties.Name="Offer when at least this sure, percent" />
                    <TextBlock Text="% sure or more" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="hint" Text="Lower: more suggestions, more of them wrong" />
                </StackPanel>
                <TextBlock Grid.Row="2" Classes="label" Text="Learns from:" VerticalAlignment="Top" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding LearnsFromText}" TextWrapping="Wrap" />
                  <TextBlock Classes="hint" Text="Accepted suggestions teach it too" />
                </StackPanel>
                <TextBlock Grid.Row="3" Classes="label" Text="Reads:" VerticalAlignment="Top" Margin="0,6,10,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2" IsEnabled="{Binding SuggestProjects}">
                  <CheckBox Content="Applications, sites and window titles" IsChecked="True" IsEnabled="False" />
                  <CheckBox Content="Text on the screen" IsChecked="{Binding ReadScreenText}" />
                  <TextBlock Classes="hint" Margin="26,0,0,0" Text="Better guesses for terminals and plain titles · some CPU while recording" />
                  <TextBlock Classes="hint" Margin="26,0,0,0" Text="Apps, sites and projects opt out on their own tabs" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,6,0,0" IsVisible="{Binding CanReadScreens}">
                    <Button Content="Read Past Days" Command="{Binding ReadPastDaysCommand}" IsEnabled="{Binding CanReadPastDays}"
                            ToolTip.Tip="Read the screens of everything recorded before, time with a project first" />
                    <NumericUpDown Value="{Binding PastReadingThreads}" Minimum="1" Maximum="{Binding MaxPastReadingThreads}" Increment="1"
                                   FormatString="0" Width="72" IsEnabled="{Binding !IsReadingPastDays}"
                                   AutomationProperties.Name="Threads reading past days" />
                    <TextBlock Text="threads" VerticalAlignment="Center" />
                    <Button Content="Stop" Command="{Binding StopReadingPastDaysCommand}" IsVisible="{Binding IsReadingPastDays}" />
                    <TextBlock Text="{Binding PastDaysText}" Classes="secondary" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="hint" Margin="26,0,0,0" IsVisible="{Binding CanReadScreens}"
                             Text="More threads: faster, busier computer · stopping keeps what's read" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="group" IsEnabled="{Binding SuggestProjects}">
            <StackPanel>
              <TextBlock Classes="groupHeader" Text="Breaks inside a block" />
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Classes="label" Text="Part of the block under:" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <NumericUpDown Value="{Binding GlanceMinutes}" Minimum="0" Maximum="30" Increment="1" FormatString="0" Width="72"
                                 AutomationProperties.Name="Part of the block under, minutes" />
                  <TextBlock Text="minutes" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="1" Classes="label" Text="Ends the block over:" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <NumericUpDown Value="{Binding SplitMinutes}" Minimum="1" Maximum="240" Increment="5" FormatString="0" Width="72"
                                 AutomationProperties.Name="Ends the block over, minutes" />
                  <TextBlock Text="minutes" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint" TextWrapping="Wrap"
                           Text="Breaks in between are yours to count or not · idle is a break" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
