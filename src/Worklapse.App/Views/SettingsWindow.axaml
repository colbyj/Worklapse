<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Worklapse.App.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Worklapse.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings — Worklapse"
        Icon="avares://Worklapse/Assets/worklapse.ico"
        Width="620" Height="600" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <!-- Column headers of the Programs list: flat, click to sort. -->
    <Style Selector="Button.columnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.columnHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BreezeAccentTintBrush}" />
    </Style>
    <!-- Dense rows: Fluent's check box template is 32 px tall around a 20 px box, which made each row ~38 px;
         the rows' check boxes overlap the row padding by 6 px above and below instead (see their Margin). -->
    <Style Selector="ListBox.programs ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.programs CheckBox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="10,4,10,0" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="buttonBar">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="Defaults" Click="OnDefaults" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="OK" Classes="accent" IsDefault="True" IsEnabled="{Binding HasDataFolder}" Click="OnOk" />
          <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
          <Button Content="Apply" IsEnabled="{Binding CanApply}" Click="OnApply" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl>
      <TabItem Header="General">
    <ScrollViewer BorderBrush="{DynamicResource BreezeSeparatorBrush}" BorderThickness="0,1,0,0">
      <StackPanel Margin="14,12" Spacing="10">

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="groupHeader" Text="Capture" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Classes="label" Text="Capture:" VerticalAlignment="Top" Margin="0,6,10,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <RadioButton GroupName="mode" Content="Active application only" IsChecked="{Binding IsActiveApplication}" />
                <RadioButton GroupName="mode" Content="Primary monitor" IsChecked="{Binding IsPrimaryMonitor}" />
                <RadioButton GroupName="mode" Content="Selected monitors:" IsChecked="{Binding IsSelectedMonitors}" />
                <ItemsControl ItemsSource="{Binding Monitors}" Margin="26,0,0,4" IsEnabled="{Binding IsSelectedMonitors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonitorOption">
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <RadioButton GroupName="mode" Content="All monitors" IsChecked="{Binding IsAllMonitors}" />
              </StackPanel>

              <TextBlock Grid.Row="1" Classes="label" Text="Interval:" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <NumericUpDown Value="{Binding IntervalSeconds}" Minimum="2" Maximum="300" Increment="1" FormatString="0" Width="110" />
                <TextBlock Text="seconds" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="groupHeader" Text="Idle" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Classes="label" Text="Stop capturing after:" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <NumericUpDown Value="{Binding IdleMinutes}" Minimum="1" Maximum="120" Increment="1" FormatString="0" Width="110" />
                <TextBlock Text="minutes without keyboard or mouse input" VerticalAlignment="Center" />
              </StackPanel>
              <CheckBox Grid.Row="1" Grid.Column="1" Content="Stop capturing while the screen is locked" IsChecked="{Binding PauseWhenLocked}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint"
                         Text="When the idle limit is reached, the minutes since the last input are counted as idle too." />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="groupHeader" Text="Recording" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Classes="label" Text="Store captures as:" VerticalAlignment="Top" Margin="0,6,10,0" />
              <!-- What each choice costs, from the measurements in docs/PROJECT.md (Benchmarks). -->
              <StackPanel Grid.Column="1" Spacing="10">
                <RadioButton GroupName="format" IsChecked="{Binding IsVideo}" AutomationProperties.Name="Video (AV1)">
                  <StackPanel>
                    <TextBlock Text="Video (AV1)" />
                    <TextBlock Classes="hint"
                               Text="Smallest on disk: about 75–100 MB for an 8-hour day on four monitors. But small text can show an older value for a while, and encoding takes about 300 MB more memory while each 15 minutes of video is encoded." />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="format" IsChecked="{Binding IsJpeg}" AutomationProperties.Name="JPEG images">
                  <StackPanel>
                    <TextBlock Text="JPEG images" />
                    <TextBlock Classes="hint"
                               Text="A picture of each change, exact for its moment, that other programs can open. Least CPU, and less memory than video. But many times the disk space of video, and text gets blurry at low quality." />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="format" IsChecked="{Binding IsWebP}" AutomationProperties.Name="WebP images">
                  <StackPanel>
                    <TextBlock Text="WebP images" />
                    <TextBlock Classes="hint"
                               Text="Like JPEG, with clearer text for the same disk space. But still many times the disk space of video, and each change takes about as much CPU as encoding video." />
                  </StackPanel>
                </RadioButton>
              </StackPanel>

              <!-- One slider per format. Image quality runs the other way round from the video quantizer, so each
                   is sharper on the left. -->
              <TextBlock Grid.Row="1" Classes="label" Text="Compression:" IsVisible="{Binding IsVideo}" />
              <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsVideo}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding QualityText}" FontWeight="SemiBold" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Classes="hint" Text="Smaller" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock DockPanel.Dock="Left" Classes="hint" Text="Sharper" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Value="{Binding Quality}" Minimum="20" Maximum="55" TickFrequency="1" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="Video compression" />
              </DockPanel>
              <TextBlock Grid.Row="1" Classes="label" Text="Quality:" IsVisible="{Binding IsJpeg}" />
              <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsJpeg}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding JpegQualityText}" FontWeight="SemiBold" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Classes="hint" Text="Smaller" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock DockPanel.Dock="Left" Classes="hint" Text="Sharper" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Value="{Binding JpegQuality}" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                        IsDirectionReversed="True" AutomationProperties.Name="JPEG quality" />
              </DockPanel>
              <TextBlock Grid.Row="1" Classes="label" Text="Quality:" IsVisible="{Binding IsWebP}" />
              <DockPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsWebP}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding WebPQualityText}" FontWeight="SemiBold" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Classes="hint" Text="Smaller" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock DockPanel.Dock="Left" Classes="hint" Text="Sharper" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Value="{Binding WebPQuality}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                        IsDirectionReversed="True" AutomationProperties.Name="WebP quality" />
              </DockPanel>

              <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint" Text="Applies to captures recorded from now on." />
              <TextBlock Grid.Row="3" Grid.Column="1" Classes="warning" IsVisible="{Binding QualityWarning}"
                         Text="At this setting small text can come out garbled or out of date." />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="group">
          <StackPanel>
            <TextBlock Classes="groupHeader" Text="Storage" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Classes="label" Text="History folder:" />
              <DockPanel Grid.Column="1">
                <Button DockPanel.Dock="Right" Content="Default" Margin="6,0,0,0" Click="OnDefaultFolder"
                        ToolTip.Tip="Use the standard history folder" />
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowse" />
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Padding="8,5" Click="OnOpenFolder" IsEnabled="{Binding DataFolderExists}"
                        ToolTip.Tip="Open this folder" AutomationProperties.Name="Open the history folder">
                  <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                </Button>
                <TextBox Text="{Binding DataFolder}" />
              </DockPanel>
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="warning" IsVisible="{Binding !HasDataFolder}"
                         Text="Choose a history folder (Browse…), or Default for the standard one." />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint"
                         Text="Recordings and the activity log are kept here. Changing it doesn't move existing history." />
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
      </TabItem>

      <TabItem Header="Programs">
        <DockPanel Margin="14,12" DataContext="{Binding Programs}" x:DataType="vm:ProgramsViewModel">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Classes="secondary" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox Text="{Binding Filter}" PlaceholderText="Filter by name" Width="240" HorizontalAlignment="Left" />
          </DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="A website decides for the pages recorded on it; a browser marked productive counts only for its pages without a known site (private windows, browser pages, captures from before sites were recorded). Changes apply to all history." />
          <Border BorderBrush="{DynamicResource BreezeFrameBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource BreezeViewBrush}" ClipToBounds="True">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="{DynamicResource BreezeHeaderBrush}" BorderBrush="{DynamicResource BreezeSeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="110,*,90,100" Margin="0,0,16,0">
                  <Button Classes="columnHeader" Content="{Binding ProductiveHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Productive}" />
                  <Button Grid.Column="1" Classes="columnHeader" Content="{Binding NameHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Name}" />
                  <Button Grid.Column="2" Classes="columnHeader" Content="{Binding KindHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Kind}" />
                  <Button Grid.Column="3" Classes="columnHeader" Content="{Binding RecordedHeader}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProgramSort.Recorded}" HorizontalContentAlignment="Right" />
                </Grid>
              </Border>
              <ListBox Classes="programs" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProgramRow">
                    <Grid ColumnDefinitions="102,*,90,92">
                      <CheckBox IsChecked="{Binding Productive}" AutomationProperties.Name="{Binding Name, StringFormat='Productive: {0}'}"
                                HorizontalAlignment="Left" Margin="2,-6,0,-6" Padding="0" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding KindText}" Classes="secondary" VerticalAlignment="Center" Margin="8,0,0,0" />
                      <TextBlock Grid.Column="3" Text="{Binding RecordedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
