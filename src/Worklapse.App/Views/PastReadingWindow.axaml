<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Worklapse.App.ViewModels"
        x:Class="Worklapse.App.Views.PastReadingWindow"
        x:DataType="vm:PastReadingViewModel"
        Title="Reading Past Screens — Worklapse"
        Icon="avares://Worklapse/Assets/worklapse.ico"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.mark">
      <Setter Property="Width" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="buttonBar">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{Binding ActionText}" Command="{Binding ActCommand}" IsVisible="{Binding HasAction}" />
        <Button Content="Close" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </Border>

    <StackPanel Margin="16,14" Spacing="6">
      <DockPanel>
        <TextBlock Classes="mark" Text="{Binding TrainingMark}" />
        <TextBlock DockPanel.Dock="Right" Classes="secondary" Text="{Binding TrainingText}" />
        <TextBlock Text="Time with a project" />
      </DockPanel>
      <DockPanel>
        <TextBlock Classes="mark" Text="{Binding RestMark}" />
        <TextBlock Text="Everything else" />
      </DockPanel>
      <ProgressBar Margin="18,4,0,0" Minimum="0" Maximum="100" Value="{Binding Percent}" />
      <TextBlock Margin="18,0,0,0" Text="{Binding CountText}" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
        <TextBlock Text="Threads" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Threads}" Minimum="1" Maximum="{Binding MaxThreads}" Increment="1" FormatString="0" Width="72"
                       AutomationProperties.Name="Threads reading past screens" />
      </StackPanel>
      <TextBlock Classes="hint" Text="More threads: faster, busier computer" />
    </StackPanel>
  </DockPanel>
</Window>
