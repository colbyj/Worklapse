<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Worklapse.App.ViewModels"
        x:Class="Worklapse.App.Views.StatusWindow"
        x:DataType="vm:StatusViewModel"
        Title="Worklapse"
        Icon="avares://Worklapse/Assets/worklapse.ico"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="buttonBar">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{Binding PauseText}" Command="{Binding TogglePauseCommand}" Classes="accent" />
        <Button Content="Review Day…" Command="{Binding OpenReviewCommand}" />
        <Button Content="Settings…" Command="{Binding OpenSettingsCommand}" />
      </StackPanel>
    </Border>

    <StackPanel Margin="16,14" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StateText}" FontSize="16" FontWeight="SemiBold" />
      </StackPanel>
      <TextBlock Text="{Binding ModeText}" />
      <TextBlock Text="{Binding DetailText}" Classes="secondary" TextWrapping="Wrap"
                 Classes.warning="{Binding HasError}" />
      <TextBlock Text="{Binding DeletedContentText}" Classes="secondary warning" TextWrapping="Wrap"
                 IsVisible="{Binding HasDeletedContentLeft}" Margin="0,6,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
