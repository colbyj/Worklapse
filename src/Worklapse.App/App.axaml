<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Worklapse.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Worklapse/Styles/BreezeResources.axaml" />
        <ResourceInclude Source="avares://Worklapse/Styles/BreezeControls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent's control templates in their compact density. The colours they read come from Styles/BreezeResources.axaml,
         recoloured to match the OS by Theming/ThemeManager, which also picks Fluent's light or dark variant for the rest. -->
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Worklapse/Styles/Breeze.axaml" />
  </Application.Styles>
</Application>
