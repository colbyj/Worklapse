<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Worklapse</AssemblyName>
    <RootNamespace>Worklapse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/worklapse.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- On Linux the application menu entry (the desktop file Worklapse writes) shows this file. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="Assets/worklapse.png" Link="worklapse.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentIcons.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Worklapse.Core/Worklapse.Core.csproj" />
    <ProjectReference Include="../Worklapse.Video/Worklapse.Video.csproj" />
    <ProjectReference Include="../Worklapse.Capture.Linux/Worklapse.Capture.Linux.csproj" />
    <ProjectReference Include="../Worklapse.Capture.Windows/Worklapse.Capture.Windows.csproj" />
    <!-- The 32-bit helper that reads TimeSnapper's database for the import, copied next to Worklapse.exe. -->
    <ProjectReference Include="../Worklapse.TimeSnapperReader/Worklapse.TimeSnapperReader.csproj" ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=net48" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
