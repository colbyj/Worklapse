<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Worklapse</AssemblyName>
    <RootNamespace>Worklapse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/worklapse.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- On Linux the application menu entry (the desktop file Worklapse writes) shows this file. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="Assets/worklapse.png" Link="worklapse.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentIcons.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Worklapse.Core/Worklapse.Core.csproj" />
    <ProjectReference Include="../Worklapse.Video/Worklapse.Video.csproj" />
    <ProjectReference Include="../Worklapse.Capture.Linux/Worklapse.Capture.Linux.csproj" />
    <ProjectReference Include="../Worklapse.Capture.Windows/Worklapse.Capture.Windows.csproj" />
  </ItemGroup>

</Project>
