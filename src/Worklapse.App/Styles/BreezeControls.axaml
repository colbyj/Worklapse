<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Desktop templates for the controls whose Fluent templates are touch-shaped beyond what resources can change:
    scroll bars (Fluent's are thin overlays that only appear on hover), tabs (Fluent's are text with an underline),
    check boxes and radio buttons (20 px marks fixed inside Fluent's templates), number box spinners (Fluent
    puts two large buttons side by side), and calendars and date fields (Fluent's are 40 px touch grids).
  -->

  <!-- Scroll bars: an always-visible track with a thumb inside it and small arrow buttons at the ends. -->
  <x:Double x:Key="UiScrollBarSize">14</x:Double>

  <ControlTheme x:Key="BreezeScrollBarLineButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource UiSecondaryTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="2">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource UiAccentTintBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BreezeScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="BreezeScrollBarThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource UiScrollThumbBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource UiAccentHoverBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource UiAccentBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource UiScrollTrackBrush}" />
    <Setter Property="MinWidth" Value="{DynamicResource UiScrollBarSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource UiScrollBarSize}" />

    <Style Selector="^:vertical">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource UiSeparatorBrush}" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
              <RepeatButton Name="PART_LineUpButton" Theme="{StaticResource BreezeScrollBarLineButton}"
                            Height="{DynamicResource UiScrollBarSize}" AutomationProperties.Name="Line up">
                <PathIcon Width="7" Height="4" Data="M0,4 L3.5,0 L7,4 Z" />
              </RepeatButton>
              <Track Grid.Row="1"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="True">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Classes="largeIncrease" Theme="{StaticResource BreezeScrollBarPageButton}"
                                AutomationProperties.Name="Page up" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Classes="largeIncrease" Theme="{StaticResource BreezeScrollBarPageButton}"
                                AutomationProperties.Name="Page down" />
                </Track.IncreaseButton>
                <Thumb Theme="{StaticResource BreezeScrollBarThumb}" Margin="3,0,3,0" MinHeight="20" AutomationProperties.Name="Position" />
              </Track>
              <RepeatButton Name="PART_LineDownButton" Grid.Row="2" Theme="{StaticResource BreezeScrollBarLineButton}"
                            Height="{DynamicResource UiScrollBarSize}" AutomationProperties.Name="Line down">
                <PathIcon Width="7" Height="4" Data="M0,0 L3.5,4 L7,0 Z" />
              </RepeatButton>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource UiSeparatorBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <RepeatButton Name="PART_LineUpButton" Theme="{StaticResource BreezeScrollBarLineButton}"
                            Width="{DynamicResource UiScrollBarSize}" AutomationProperties.Name="Column left">
                <PathIcon Width="4" Height="7" Data="M4,0 L0,3.5 L4,7 Z" />
              </RepeatButton>
              <Track Grid.Column="1"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Classes="largeIncrease" Theme="{StaticResource BreezeScrollBarPageButton}"
                                AutomationProperties.Name="Page left" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Classes="largeIncrease" Theme="{StaticResource BreezeScrollBarPageButton}"
                                AutomationProperties.Name="Page right" />
                </Track.IncreaseButton>
                <Thumb Theme="{StaticResource BreezeScrollBarThumb}" Margin="0,3,0,3" MinWidth="20" AutomationProperties.Name="Position" />
              </Track>
              <RepeatButton Name="PART_LineDownButton" Grid.Column="2" Theme="{StaticResource BreezeScrollBarLineButton}"
                            Width="{DynamicResource UiScrollBarSize}" AutomationProperties.Name="Column right">
                <PathIcon Width="4" Height="7" Data="M0,0 L4,3.5 L0,7 Z" />
              </RepeatButton>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <!--
    Tabs: a framed page with the tabs standing on it; the selected tab is framed too, has the page's colour and
    covers the page's top edge below it (it overlaps by 1 px and is drawn above the page), with Breeze's accent line
    along its top (UiTabMarkBrush; transparent on Windows, which has none). Only the top placement is styled, the
    one the app uses.
  -->
  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource UiWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiFrameBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0,4,4,4" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <ItemsPresenter Name="PART_ItemsPresenter" DockPanel.Dock="Top" ZIndex="1" ItemsPanel="{TemplateBinding ItemsPanel}" />
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Panel ClipToBounds="True">
              <ContentPresenter Name="PART_SelectedContentHost2"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsVisible="False" />
              <ContentPresenter Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource UiSecondaryTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Border Name="PART_SelectedPipe" Height="2" VerticalAlignment="Top" CornerRadius="3,3,0,0"
                    Background="{DynamicResource UiTabMarkBrush}" IsVisible="False" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              RecognizesAccessKey="True" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource UiHeaderBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource UiWindowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UiFrameBrush}" />
      <Setter Property="Margin" Value="0,0,0,-1" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
    </Style>
  </ControlTheme>

  <!-- Check boxes and radio buttons: 16 px marks (Fluent's are 20 px, set inside its templates). -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="MinHeight" Value="{DynamicResource CheckBoxMinHeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="16,*" Background="{TemplateBinding Background}">
          <!-- The mark centres on the first line of text when the label wraps. -->
          <Panel Height="{DynamicResource CheckBoxMinHeight}" VerticalAlignment="Top">
            <Border Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                    Background="{DynamicResource UiViewBrush}" BorderBrush="{DynamicResource UiFrameBrush}" />
            <Path Name="Mark" Width="12" Height="10" Stretch="None" Stroke="{DynamicResource UiOnAccentBrush}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round" Data="M 1.5,5.5 L 4.5,8.5 L 10.5,1.5" IsVisible="False"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Name="Dash" Width="8" Height="2" CornerRadius="1" Background="{DynamicResource UiOnAccentBrush}" IsVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextWrapping="Wrap"
                            RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
    </Style>
    <Style Selector="^:checked, ^:indeterminate">
      <Style Selector="^ /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource UiAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource UiAccentStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentStrongBrush}" />
      </Style>
    </Style>
    <Style Selector="^:checked /template/ Path#Mark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#Dash">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
      <Style Selector="^ /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource UiWindowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
      </Style>
      <Style Selector="^:checked /template/ Border#Box, ^:indeterminate /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource UiDisabledTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDisabledTextBrush}" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="MinHeight" Value="{DynamicResource RadioButtonMinHeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="16,*" Background="{TemplateBinding Background}">
          <Panel Height="{DynamicResource RadioButtonMinHeight}" VerticalAlignment="Top">
            <Ellipse Name="Ring" Width="16" Height="16" StrokeThickness="1"
                     Fill="{DynamicResource UiViewBrush}" Stroke="{DynamicResource UiFrameBrush}" />
            <Ellipse Name="Dot" Width="6" Height="6" Fill="{DynamicResource UiOnAccentBrush}" IsVisible="False" />
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse#Ring">
      <Setter Property="Stroke" Value="{DynamicResource UiAccentBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#Ring">
      <Setter Property="Fill" Value="{DynamicResource UiAccentPressedBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Style Selector="^ /template/ Ellipse#Ring">
        <Setter Property="Fill" Value="{DynamicResource UiAccentBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource UiAccentBrush}" />
      </Style>
      <Style Selector="^:pointerover /template/ Ellipse#Ring">
        <Setter Property="Fill" Value="{DynamicResource UiAccentStrongBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource UiAccentStrongBrush}" />
      </Style>
      <Style Selector="^ /template/ Ellipse#Dot">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
      <Style Selector="^ /template/ Ellipse#Ring">
        <Setter Property="Fill" Value="{DynamicResource UiWindowBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource UiSeparatorBrush}" />
      </Style>
      <Style Selector="^:checked /template/ Ellipse#Ring">
        <Setter Property="Fill" Value="{DynamicResource UiDisabledTextBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource UiDisabledTextBrush}" />
      </Style>
    </Style>
  </ControlTheme>

  <!-- Number box spinners: two small arrow buttons stacked at the right edge, as on the desktop. -->
  <ControlTheme x:Key="BreezeSpinnerButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource UiSecondaryTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource UiAccentTintBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
    <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource TextControlThemeMinWidth}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{TemplateBinding MinHeight}">
            <DockPanel>
              <Border Name="PART_SpinnerPanel" DockPanel.Dock="Right" Width="17"
                      BorderBrush="{DynamicResource UiSeparatorBrush}" BorderThickness="1,0,0,0"
                      IsVisible="{TemplateBinding ShowButtonSpinner}">
                <Grid RowDefinitions="*,*">
                  <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource BreezeSpinnerButton}"
                                IsTabStop="{TemplateBinding IsTabStop}" CornerRadius="0,3,0,0">
                    <PathIcon Width="7" Height="4" Data="M0,4 L3.5,0 L7,4 Z" />
                  </RepeatButton>
                  <RepeatButton Name="PART_DecreaseButton" Grid.Row="1" Theme="{StaticResource BreezeSpinnerButton}"
                                IsTabStop="{TemplateBinding IsTabStop}" CornerRadius="0,0,3,0">
                    <PathIcon Width="7" Height="4" Data="M0,0 L3.5,4 L7,0 Z" />
                  </RepeatButton>
                </Grid>
              </Border>
              <ContentPresenter Name="PART_ContentPresenter"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:left /template/ Border#PART_SpinnerPanel">
      <Setter Property="DockPanel.Dock" Value="Left" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
    </Style>
  </ControlTheme>

  <!--
    Calendars: a small month grid in a framed view, the month above it with arrows to step (Fluent's is a 300 px
    touch grid of framed squares). Today is framed in the accent, the chosen day has the selection tint, other
    months' days are dimmed and days that can't be picked are greyed out.
  -->
  <StreamGeometry x:Key="BreezeChevronDown">M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z</StreamGeometry>

  <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar">
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource UiViewBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiFrameBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Name="PART_Root" HorizontalAlignment="Center" ClipToBounds="True">
          <CalendarItem Name="PART_CalendarItem"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- The calendar fills PART_MonthView (day names, then six weeks) and PART_YearView (months, or years) itself. -->
  <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">
    <Setter Property="DayTitleTemplate">
      <Template x:DataType="x:String">
        <TextBlock Text="{Binding}" Foreground="{DynamicResource UiSecondaryTextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="5">
          <!-- As wide as a month in either view, so stepping from months to years doesn't resize it. -->
          <Grid RowDefinitions="Auto,*" MinWidth="210">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
              <!-- Tool buttons (Breeze.axaml): flat until hovered. -->
              <Button Name="PART_HeaderButton" Classes="tool" FontWeight="SemiBold" HorizontalAlignment="Left" />
              <Button Name="PART_PreviousButton" Grid.Column="1" Classes="tool" MinWidth="24"
                      AutomationProperties.Name="Previous">
                <PathIcon Width="10" Height="10" Data="{StaticResource BreezeChevronDown}" RenderTransform="rotate(90deg)" />
              </Button>
              <Button Name="PART_NextButton" Grid.Column="2" Classes="tool" MinWidth="24"
                      AutomationProperties.Name="Next">
                <PathIcon Width="10" Height="10" Data="{StaticResource BreezeChevronDown}" RenderTransform="rotate(-90deg)" />
              </Button>
            </Grid>
            <Grid Name="PART_MonthView" Grid.Row="1" IsVisible="False"
                  RowDefinitions="22,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*,*,*,*,*" />
            <Grid Name="PART_YearView" Grid.Row="1" IsVisible="False" MinHeight="166"
                  RowDefinitions="*,*,*" ColumnDefinitions="*,*,*,*" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- A day in the month grid. -->
  <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton">
    <Setter Property="ClickMode" Value="Release" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:inactive">
      <Setter Property="Foreground" Value="{DynamicResource UiSecondaryTextBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource UiAccentTintBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:today">
      <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    </Style>
    <Style Selector="^:blackout, ^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!-- A month (or year) when the calendar steps out to the year (or decade). -->
  <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">
    <Setter Property="ClickMode" Value="Release" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:inactive">
      <Setter Property="Foreground" Value="{DynamicResource UiSecondaryTextBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource UiAccentTintBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
    </Style>
  </ControlTheme>

  <!--
    Date fields: a text field you can type a date in, with a drop-down arrow like a drop-down list's that opens a
    calendar below it.
  -->
  <ControlTheme x:Key="BreezeDropDownArrowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ComboBoxDropDownGlyphForeground}" />
    <Setter Property="Padding" Value="6,0,10,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <PathIcon Width="12" Height="12" UseLayoutRounding="False" VerticalAlignment="Center"
                    Foreground="{TemplateBinding Foreground}" Data="{StaticResource BreezeChevronDown}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CalendarDatePicker}" TargetType="CalendarDatePicker">
    <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextControlPlaceholderForeground}" />
    <Setter Property="IsTodayHighlighted" Value="True" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="{DynamicResource TextControlThemePadding}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Panel>
            <Border Name="Background"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Name="PART_TextBox"
                       Foreground="{TemplateBinding Foreground}"
                       Background="Transparent"
                       BorderBrush="Transparent"
                       BorderThickness="0"
                       MinHeight="0"
                       Margin="{TemplateBinding BorderThickness}"
                       Padding="{TemplateBinding Padding}"
                       PlaceholderText="{TemplateBinding PlaceholderText}"
                       PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                       VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                       HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}">
                <!-- The field around it shows hover and focus, not the text box. -->
                <TextBox.Styles>
                  <Style Selector="TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement, TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement, TextBox#PART_TextBox:disabled /template/ Border#PART_BorderElement">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                </TextBox.Styles>
              </TextBox>
              <!-- Its own minimum, not push buttons' (Breeze.axaml): that would be 76 px. -->
              <Button Name="PART_Button" Grid.Column="1" Theme="{StaticResource BreezeDropDownArrowButton}" Focusable="False"
                      MinWidth="0" MinHeight="0" AutomationProperties.Name="Calendar" />
              <Popup Name="PART_Popup" PlacementTarget="{TemplateBinding}" IsLightDismissEnabled="True">
                <Calendar Name="PART_Calendar"
                          Margin="0,2,0,0"
                          FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                          IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                          SelectedDate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedDate, Mode=TwoWay}"
                          DisplayDate="{TemplateBinding DisplayDate}"
                          DisplayDateStart="{TemplateBinding DisplayDateStart}"
                          DisplayDateEnd="{TemplateBinding DisplayDateEnd}" />
              </Popup>
            </Grid>
          </Panel>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
    </Style>
    <Style Selector="^:focus-within /template/ Border#Background, ^:flyout-open /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
      <Style Selector="^ /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource UiWindowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
      </Style>
      <Style Selector="^ /template/ Button#PART_Button">
        <Setter Property="Foreground" Value="{DynamicResource UiDisabledTextBrush}" />
      </Style>
    </Style>
    <Style Selector="^:error /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
    </Style>
  </ControlTheme>

  <!--
    The custom colour picker's parts (Views/ColorField): a colour square and a hue strip, framed like the other
    fields, with a radio-button-style handle. These are their only themes: the ColorPicker package's Fluent ones
    aren't loaded.
  -->
  <ControlTheme x:Key="{x:Type ColorSpectrum}" TargetType="ColorSpectrum">
    <Setter Property="Template">
      <ControlTemplate TargetType="ColorSpectrum">
        <Panel Name="PART_LayoutRoot">
          <!-- Sized square by the control. The ring shapes are for its ring mode, unused but looked up. -->
          <Panel Name="PART_SizingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
            <Rectangle Name="PART_SpectrumRectangle" IsHitTestVisible="False" RadiusX="3" RadiusY="3" />
            <Rectangle Name="PART_SpectrumOverlayRectangle" IsHitTestVisible="False" RadiusX="3" RadiusY="3" />
            <Ellipse Name="PART_SpectrumEllipse" IsHitTestVisible="False" IsVisible="False" />
            <Ellipse Name="PART_SpectrumOverlayEllipse" IsHitTestVisible="False" IsVisible="False" />
            <Canvas Name="PART_InputTarget" Background="Transparent">
              <Panel Name="PART_SelectionEllipsePanel" Width="14" Height="14">
                <Ellipse Name="SelectionEllipse" StrokeThickness="2" Stroke="#232629" IsHitTestVisible="False" />
              </Panel>
            </Canvas>
            <Rectangle IsHitTestVisible="False" RadiusX="3" RadiusY="3" StrokeThickness="1" Stroke="{DynamicResource UiFrameBrush}" />
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- The control marks a dark colour under the ring as wanting a light ring. -->
    <Style Selector="^:light-selector /template/ Ellipse#SelectionEllipse">
      <Setter Property="Stroke" Value="#FFFFFF" />
    </Style>
    <Style Selector="^:focus-visible /template/ Ellipse#SelectionEllipse">
      <Setter Property="StrokeThickness" Value="3" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BreezeColorSliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Ellipse Name="Ring" StrokeThickness="1" Fill="{DynamicResource UiViewBrush}" Stroke="{DynamicResource UiFrameBrush}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse#Ring">
      <Setter Property="Stroke" Value="{DynamicResource UiAccentBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#Ring">
      <Setter Property="Fill" Value="{DynamicResource UiAccentPressedBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource UiAccentBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="BreezeColorSliderTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Horizontal only (all the picker uses). The strip fills the slider: the control draws its gradient for the
       slider's whole size, and a smaller strip (even one inside a frame) would get it shrunk, keeping its
       proportions, into its middle. So the frame is drawn over it. -->
  <ControlTheme x:Key="{x:Type ColorSlider}" TargetType="ColorSlider">
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ColorSlider">
        <Panel>
          <Border CornerRadius="3" Background="{TemplateBinding Background}" />
          <Border CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource UiFrameBrush}" />
          <Track Name="PART_Track" Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource BreezeColorSliderTrackButton}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource BreezeColorSliderTrackButton}" />
            </Track.IncreaseButton>
            <Thumb Name="ColorSliderThumb" Width="16" Height="16" Theme="{StaticResource BreezeColorSliderThumb}" />
          </Track>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
