<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Breeze-style layout pieces on top of BreezeResources.axaml. -->

  <!-- The font size comes from ControlContentThemeFontSize (Fluent's window theme reads it). -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource UiWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
  </Style>

  <!-- Scroll bars stay visible and take their own space beside the content, instead of appearing over it on hover.
       List boxes, text boxes and tree views hand their own (attached) setting to the scroll viewer inside them. -->
  <Style Selector="ScrollViewer, ListBox, TextBox, TreeView">
    <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
  </Style>

  <!-- Raised push buttons: a faint shadow under the gradient face (BreezeResources), none once disabled. -->
  <Style Selector="Button:not(.tool) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 1 1 0 #18000000" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <!-- No shrinking on press: a touch cue. -->
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource UiSecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource UiSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource UiNegativeBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Push buttons: Breeze keeps them at their text width with comfortable padding. -->
  <Style Selector="Button">
    <Setter Property="MinWidth" Value="76" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Header areas (tool bars), as in Plasma's "header" colour. -->
  <Style Selector="Border.toolBar">
    <Setter Property="Background" Value="{DynamicResource UiHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="4,3" />
  </Style>
  <Style Selector="Border.toolBar > WrapPanel > :is(Control)">
    <Setter Property="Margin" Value="1,0" />
  </Style>
  <Style Selector="Border.toolBar ComboBox">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Tool buttons (and toggles): flat until hovered, then Breeze's light blue face with a blue frame; a toggle
       that is on keeps the pressed look. Exclusive choices (Week / Month) are radio buttons drawn as toggles, so
       clicking the one that's on leaves it on. -->
  <Style Selector=":is(Button).tool">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Button).tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccentHoverBrush}" />
  </Style>
  <Style Selector=":is(ToggleButton).tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource UiTextBrush}" />
  </Style>
  <Style Selector=":is(Button).tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
  </Style>
  <Style Selector=":is(Button).tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="RadioButton.tool">
    <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
  </Style>
  <!-- Only the button's own content: a menu dropping down from a tool button counts as inside it, and would lay its
       items out in a row. -->
  <Style Selector=":is(Button).tool > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="5" />
  </Style>

  <!-- Links: accent text, underlined under the pointer (a date in the Timesheet that opens the day). -->
  <Style Selector="Button.link">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource UiAccentStrongBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter, Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="Foreground" Value="{DynamicResource UiAccentStrongBrush}" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <Style Selector="Border.separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Background" Value="{DynamicResource UiSeparatorBrush}" />
    <Setter Property="Margin" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusBar">
    <Setter Property="Background" Value="{DynamicResource UiWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <!-- A divider between status bar sections. -->
  <Style Selector="Border.statusDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Background" Value="{DynamicResource UiSeparatorBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Dialog button row, separated from the content the way KDE dialogs are. -->
  <Style Selector="Border.buttonBar">
    <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <!-- Group boxes: a title above a framed area. -->
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource UiViewBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource UiGroupFrameBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,7,10,9" />
  </Style>
  <Style Selector="TextBlock.groupHeader">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- Grids (Day review's side panel, the Timesheet): a header row, then dense rows with a hairline between them. -->
  <Style Selector="Grid.gridHeader">
    <Setter Property="Background" Value="{DynamicResource UiHeaderBrush}" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="Grid.gridHeader > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource UiSecondaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="6,0" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{DynamicResource UiSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Border.row TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Times in a grid line up on the right, in figures of one width. -->
  <Style Selector="TextBlock.time">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <!-- Cells you can type in: plain text until hovered or focused, as in a desktop grid. -->
  <Style Selector="TextBox.cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
</Styles>
